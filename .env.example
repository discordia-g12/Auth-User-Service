# Solo para correr la app, Alembic o scripts DESDE EL HOST contra la base que
# levanta discordia-orchestrator (auth-db, publicada en el puerto 5436).
#   cp .env.example .env
# Dentro del contenedor no se usa: el orquestador define todas las DATABASE_*
# como variables de entorno, que tienen prioridad sobre este archivo.
ENVIRONMENT=development
DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_NAME=auth_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Recupero de contraseña (ADR-006)
AUTH0_DOMAIN=dev-dppme5iaqg60gkmo.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_DB_CONNECTION=Username-Password-Authentication
