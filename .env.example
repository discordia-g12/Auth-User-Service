# Solo para correr la app, Alembic, el worker o scripts DESDE EL HOST contra los
# servicios que levanta discordia-orchestrator.
#   cp .env.example .env      

ENVIRONMENT=development

DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_NAME=auth_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

AUTH0_DOMAIN=dev-dppme5iaqg60gkmo.us.auth0.com
AUTH0_CLIENT_ID=f2H8PhlKDl3KSIm64G5mHAeQih7iFyIP
AUTH0_DB_CONNECTION=Username-Password-Authentication

# Suspensión de usuarios (ADR-002). Aplicación Machine to Machine de Auth0 (read:users, update:users)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Redis del Gateway (lista de cuentas suspendidas); desde el host, el que publica el orquestador
GATEWAY_REDIS_HOST=localhost
GATEWAY_REDIS_PORT=6379

# Avatares (S3).
# Claves del usuario IAM del servicio (o uno de desarrollo). Sin claves o sin bucket, la subida responde 503.
AWS_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=